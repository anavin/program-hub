# ─────────────────────────────────────────────────────────────
# Supabase — คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
# หา URL / anon key ได้ที่ Supabase → Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ถ้ายังไม่ใส่ค่า 2 บรรทัดบน แอปจะรันใน "โหมดตัวอย่าง" (mock)
# ใช้ข้อมูล seed ในเครื่อง + ล็อกอินตัวอย่าง:
#   admin@labparfumo.local / admin1234   (แอดมิน)
#   user@labparfumo.local  / user1234    (พนักงานทั่วไป)
